+#[cfg(test)]
+mod new_window_tests {
+  use super::{NewWindowFeatures, NewWindowOpener, RuntimeNewWindowOpener};
+  use crate::dpi::{LogicalPosition, LogicalSize};
+
+  // Existing native callers retain these exact constructor/accessor signatures.
+  const _: fn(
+    Option<LogicalSize<f64>>,
+    Option<LogicalPosition<f64>>,
+    NewWindowOpener,
+  ) -> NewWindowFeatures = NewWindowFeatures::new;
+  const _: fn(&NewWindowFeatures) -> &NewWindowOpener = NewWindowFeatures::opener;
+
+  #[test]
+  fn runtime_features_preserve_geometry_and_typed_token() {
+    let size = Some(LogicalSize::new(640.0, 480.0));
+    let position = Some(LogicalPosition::new(20.0, 30.0));
+    let features =
+      NewWindowFeatures::new_for_runtime(size, position, RuntimeNewWindowOpener::new(42_u64));
+
+    assert_eq!(features.size(), size);
+    assert_eq!(features.position(), position);
+    assert!(features.native_opener().is_none());
+    let opener = features.runtime_opener().unwrap();
+    assert_eq!(opener.downcast_ref::<u64>(), Some(&42));
+    assert!(opener.downcast_ref::<String>().is_none());
+  }
+
+  #[test]
+  fn cloned_token_shares_identity_across_threads() {
+    let opener = RuntimeNewWindowOpener::new(String::from("request"));
+    let copy = opener.clone();
+    assert!(std::ptr::eq(
+      opener.downcast_ref::<String>().unwrap(),
+      copy.downcast_ref::<String>().unwrap(),
+    ));
+    std::thread::spawn(move || {
+      assert_eq!(copy.downcast_ref::<String>().unwrap(), "request");
+    })
+    .join()
+    .unwrap();
+  }
+
+  #[test]
+  fn debug_does_not_expose_token_contents() {
+    let opener = RuntimeNewWindowOpener::new("private-request-data");
+    assert!(!format!("{opener:?}").contains("private-request-data"));
+  }
+
+  #[test]
+  #[should_panic(expected = "runtime-owned window features do not have a native opener")]
+  fn legacy_accessor_rejects_runtime_owned_features() {
+    NewWindowFeatures::new_for_runtime(None, None, RuntimeNewWindowOpener::new(42_u64)).opener();
   }
 }
 
