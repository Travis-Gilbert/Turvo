@@ -0,0 +1,37 @@
+// Copyright 2019-2024 Tauri Programme within The Commons Conservancy
+// SPDX-License-Identifier: Apache-2.0
+// SPDX-License-Identifier: MIT
+
+#![cfg(all(feature = "test", not(any(target_os = "android", target_os = "ios"))))]
+
+use tauri::{
+  test::{mock_builder, mock_context, noop_assets},
+  webview::{NewWindowFeatures, RuntimeNewWindowOpener},
+  Manager, WebviewUrl, WebviewWindowBuilder,
+};
+
+#[test]
+fn mock_runtime_still_creates_windows_without_an_opener() {
+  let app = mock_builder().build(mock_context(noop_assets())).unwrap();
+  WebviewWindowBuilder::new(&app, "ordinary", WebviewUrl::default())
+    .build()
+    .unwrap();
+  assert!(app.get_webview_window("ordinary").is_some());
+}
+
+#[test]
+fn unsupported_runtime_opener_is_not_silently_dropped() {
+  let app = mock_builder().build(mock_context(noop_assets())).unwrap();
+  let features =
+    NewWindowFeatures::new_for_runtime(None, None, RuntimeNewWindowOpener::new(42_u64));
+  let result = WebviewWindowBuilder::new(&app, "child", WebviewUrl::default())
+    .window_features(features)
+    .build();
+  assert!(matches!(
+    result,
+    Err(tauri::Error::Runtime(
+      tauri_runtime::Error::UnsupportedNewWindowOpener
+    ))
+  ));
+  assert!(app.get_webview_window("child").is_none());
+}
