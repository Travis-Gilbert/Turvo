+  /// Returns the native opener, if this request came from a native webview runtime.
+  pub fn native_opener(&self) -> Option<&NewWindowOpener> {
+    match &self.opener {
+      NewWindowOpenerKind::Native(opener) => Some(opener),
+      NewWindowOpenerKind::Runtime(_) => None,
+    }
+  }
+
+  /// Returns the opaque opener, if this request came from a custom runtime.
+  pub fn runtime_opener(&self) -> Option<&RuntimeNewWindowOpener> {
+    match &self.opener {
+      NewWindowOpenerKind::Native(_) => None,
+      NewWindowOpenerKind::Runtime(opener) => Some(opener),
+    }
+  }
+}
