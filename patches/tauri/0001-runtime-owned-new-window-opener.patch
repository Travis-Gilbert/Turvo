+#[derive(Debug)]
+enum NewWindowOpenerKind {
+  Native(NewWindowOpener),
+  Runtime(RuntimeNewWindowOpener),
+}
+
+/// An opaque opener token owned and interpreted by a custom [`Runtime`].
+///
+/// This lets a runtime preserve its engine's new-window request without constructing
+/// WebKit or WebView2 objects. Store thread-safe identifiers here, not thread-affine
+/// engine objects. The receiving runtime must validate the token's type, ownership,
+/// lifetime, and single-use requirements before creating the related webview.
+///
+/// Cloning this value shares the token; it does not authorize another window.
+#[derive(Clone)]
+pub struct RuntimeNewWindowOpener(Arc<dyn Any + Send + Sync>);
+
+impl std::fmt::Debug for RuntimeNewWindowOpener {
+  fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+    f.debug_struct("RuntimeNewWindowOpener")
+      .finish_non_exhaustive()
+  }
+}
+
+impl RuntimeNewWindowOpener {
+  /// Wraps a thread-safe, runtime-owned opener token.
+  pub fn new<T: Any + Send + Sync>(token: T) -> Self {
+    Self(Arc::new(token))
+  }
+
+  /// Returns the token when its concrete type matches the receiving runtime.
+  /// A type match alone does not establish that the opener is still valid.
+  pub fn downcast_ref<T: Any>(&self) -> Option<&T> {
+    self.0.downcast_ref()
+  }
 }
 
