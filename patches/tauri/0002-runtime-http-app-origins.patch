+// Copyright 2019-2024 Tauri Programme within The Commons Conservancy
+// SPDX-License-Identifier: Apache-2.0
+// SPDX-License-Identifier: MIT
+
+import assert from 'node:assert/strict'
+import { readFileSync } from 'node:fs'
+import test from 'node:test'
+import { runInNewContext } from 'node:vm'
+
+const template = readFileSync(new URL('./core.js', import.meta.url), 'utf8')
+
+function core(useHttp, protocolScheme) {
+  const script = template
+    .replaceAll('__TEMPLATE_custom_protocols_use_http__', JSON.stringify(useHttp))
+    .replaceAll('__TEMPLATE_protocol_scheme__', JSON.stringify(protocolScheme))
+  assert.doesNotMatch(script, /__TEMPLATE_/)
+  const window = { __TAURI_INTERNALS__: {} }
+  runInNewContext(script, { window })
+  return window.__TAURI_INTERNALS__
+}
+
+for (const { useHttp, scheme, prefix } of [
+  { useHttp: false, scheme: 'http', prefix: 'asset://localhost/' },
+  { useHttp: false, scheme: 'https', prefix: 'asset://localhost/' },
+  { useHttp: true, scheme: 'http', prefix: 'http://asset.localhost/' },
+  { useHttp: true, scheme: 'https', prefix: 'https://asset.localhost/' }
+]) {
+  test(`convertFileSrc uses runtime mapping ${useHttp} with ${scheme}`, () => {
+    assert.equal(
+      core(useHttp, scheme).convertFileSrc('/tmp/a b#?.png'),
+      `${prefix}%2Ftmp%2Fa%20b%23%3F.png`
+    )
+  })
+}
+
+test('convertFileSrc maps a caller-selected protocol without rewriting the path', () => {
+  assert.equal(
+    core(true, 'https').convertFileSrc('tauri://localhost/nested?a=1', 'myproto'),
+    'https://myproto.localhost/tauri%3A%2F%2Flocalhost%2Fnested%3Fa%3D1'
+  )
+})
