@@ -403,6 +403,19 @@ pub struct RuntimeInitArgs {
 
 /// The webview runtime interface.
 pub trait Runtime<T: UserEvent>: Debug + Sized + 'static {
+  /// Whether custom protocols use HTTP(S) URLs such as `http://tauri.localhost/`.
+  ///
+  /// The default preserves the native runtime convention on Windows and Android.
+  /// Other runtimes may opt in on any platform. The runtime must serve the mapped
+  /// requests in process, preserve their browser-visible URLs, and enforce the
+  /// engine's origin, CORS, and content-security policies. Before calling a
+  /// registered protocol handler, translate the request URL back to its custom
+  /// protocol form without changing the engine's URL or authenticated origin.
+  /// This does not start a server, make custom protocols cross-origin accessible,
+  /// or select an IPC transport.
+  /// The webview's `use_https_scheme` option chooses HTTP versus HTTPS.
+  const CUSTOM_PROTOCOLS_USE_HTTP: bool = cfg!(any(windows, target_os = "android"));
+
   /// The window message dispatcher.
   type WindowDispatcher: WindowDispatch<T, Runtime = Self>;
   /// The webview message dispatcher.
