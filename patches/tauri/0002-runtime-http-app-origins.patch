 //! Custom protocol handlers
 
+use url::Url;
+
 #[cfg(feature = "protocol-asset")]
 pub mod asset;
 #[cfg(feature = "isolation")]
 pub mod isolation;
 pub mod tauri;
+
+pub(crate) fn custom_protocol_url(protocol: &str, https: bool, use_http: bool) -> Url {
+  let url = if use_http {
+    let scheme = if https { "https" } else { "http" };
+    format!("{scheme}://{protocol}.localhost")
+  } else {
+    format!("{protocol}://localhost")
+  };
+  Url::parse(&url).expect("valid custom protocol URL")
+}
+
+/// Match the complete bundled authority, including the port. Custom schemes
+/// cannot use `Url::origin()` here because rust-url gives them opaque origins.
+pub(crate) fn is_custom_protocol_url(url: &Url, protocol: &str, use_http: bool) -> bool {
+  let expected = custom_protocol_url(protocol, url.scheme() == "https", use_http);
+  url.scheme() == expected.scheme()
+    && url.host() == expected.host()
+    && url.port_or_known_default() == expected.port_or_known_default()
+    && url.username().is_empty()
+    && url.password().is_none()
+}
+
+#[cfg(test)]
+mod tests {
+  use super::{custom_protocol_url, is_custom_protocol_url};
+  use url::Url;
+
+  #[test]
+  fn custom_protocol_url_uses_runtime_mapping() {
+    for (https, use_http, expected) in [
+      (false, false, "tauri://localhost"),
+      (true, false, "tauri://localhost"),
+      (false, true, "http://tauri.localhost/"),
+      (true, true, "https://tauri.localhost/"),
+    ] {
+      assert_eq!(
+        custom_protocol_url("tauri", https, use_http).as_str(),
+        expected
+      );
+    }
+    assert_eq!(
+      custom_protocol_url("myproto", false, true).as_str(),
+      "http://myproto.localhost/"
+    );
+  }
+
+  #[test]
+  fn mapped_protocol_authority_includes_port_and_credentials() {
+    for url in [
+      "http://tauri.localhost/path?query=1#fragment",
+      "http://tauri.localhost:80/",
+      "https://tauri.localhost:443/",
+    ] {
+      assert!(
+        is_custom_protocol_url(&Url::parse(url).unwrap(), "tauri", true),
+        "{url}"
+      );
+    }
+    for url in [
+      "http://tauri.localhost:8080/",
+      "https://tauri.localhost:80/",
+      "http://user@tauri.localhost/",
+      "http://user:password@tauri.localhost/",
+      "http://tauri.localhost.evil.example/",
+      "http://nested.tauri.localhost/",
+      "http://notregistered.localhost/",
+      "tauri://localhost/",
+    ] {
+      assert!(
+        !is_custom_protocol_url(&Url::parse(url).unwrap(), "tauri", true),
+        "{url}"
+      );
+    }
+  }
+
+  #[test]
+  fn native_protocol_authority_does_not_accept_http_or_other_ports() {
+    assert!(is_custom_protocol_url(
+      &Url::parse("tauri://localhost/path").unwrap(),
+      "tauri",
+      false
+    ));
+    for url in [
+      "tauri://localhost:1234/",
+      "tauri://other-host/",
+      "tauri://user@localhost/",
+      "http://tauri.localhost/",
+    ] {
+      assert!(
+        !is_custom_protocol_url(&Url::parse(url).unwrap(), "tauri", false),
+        "{url}"
+      );
+    }
+  }
+
+  #[test]
+  fn mapped_isolation_authority_is_exact() {
+    let schema = "isolation-123";
+    assert!(is_custom_protocol_url(
+      &Url::parse("http://isolation-123.localhost/index.html").unwrap(),
+      schema,
+      true
+    ));
+    for url in [
+      "http://isolation-123.localhost:8080/",
+      "http://user@isolation-123.localhost/",
+      "http://isolation-123.localhost.evil.example/",
+      "http://isolation-456.localhost/",
+    ] {
+      assert!(
+        !is_custom_protocol_url(&Url::parse(url).unwrap(), schema, true),
+        "{url}"
+      );
+    }
+  }
+}
