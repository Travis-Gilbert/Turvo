@@ -0,0 +1,84 @@
+// Copyright 2019-2024 Tauri Programme within The Commons Conservancy
+// SPDX-License-Identifier: Apache-2.0
+// SPDX-License-Identifier: MIT
+
+#![cfg(all(feature = "test", not(any(target_os = "android", target_os = "ios"))))]
+
+use tauri::{
+  ipc::{CallbackFn, InvokeBody},
+  test::{get_ipc_response, mock_builder, mock_context, noop_assets, MockRuntime, INVOKE_KEY},
+  webview::InvokeRequest,
+  WebviewUrl, WebviewWindowBuilder,
+};
+
+#[tauri::command]
+fn ping() -> &'static str {
+  "pong"
+}
+
+#[test]
+fn default_mock_runtime_keeps_platform_app_urls() {
+  assert_eq!(
+    <MockRuntime as tauri_runtime::Runtime<()>>::CUSTOM_PROTOCOLS_USE_HTTP,
+    cfg!(any(windows, target_os = "android"))
+  );
+  let app = mock_builder().build(mock_context(noop_assets())).unwrap();
+  for (label, https) in [("http", false), ("https", true)] {
+    let webview = WebviewWindowBuilder::new(&app, label, WebviewUrl::default())
+      .use_https_scheme(https)
+      .build()
+      .unwrap();
+    let expected = if cfg!(windows) {
+      if https {
+        "https://tauri.localhost/"
+      } else {
+        "http://tauri.localhost/"
+      }
+    } else {
+      "tauri://localhost"
+    };
+    assert_eq!(webview.url().unwrap().as_str(), expected);
+  }
+}
+
+#[test]
+fn bundled_authority_other_ports_and_credentials_do_not_receive_local_ipc_permissions() {
+  let app = mock_builder()
+    .invoke_handler(tauri::generate_handler![ping])
+    .build(mock_context(noop_assets()))
+    .unwrap();
+  let webview = WebviewWindowBuilder::new(&app, "main", WebviewUrl::default())
+    .build()
+    .unwrap();
+  let local_url = webview.url().unwrap();
+  let mut other_port = local_url.clone();
+  other_port.set_port(Some(43210)).unwrap();
+  let mut with_credentials = local_url.clone();
+  with_credentials.set_username("user").unwrap();
+  with_credentials.set_password(Some("password")).unwrap();
+  for (url, allowed) in [
+    (local_url, true),
+    (other_port, false),
+    (with_credentials, false),
+  ] {
+    let response = get_ipc_response(
+      &webview,
+      InvokeRequest {
+        cmd: "ping".into(),
+        callback: CallbackFn(0),
+        error: CallbackFn(1),
+        url,
+        body: InvokeBody::default(),
+        headers: Default::default(),
+        invoke_key: INVOKE_KEY.to_string(),
+      },
+    );
+    assert_eq!(response.is_ok(), allowed);
+    if allowed {
+      assert_eq!(response.unwrap().deserialize::<String>().unwrap(), "pong");
+    }
+  }
+}
+
+// Keep the original non-generic MockRuntime type in the public test API.
+const _: fn() -> tauri::Builder<MockRuntime> = mock_builder;
