+use dom_struct::dom_struct;
+use js::context::JSContext;
+use script_bindings::reflector::{Reflector, reflect_dom_object_with_cx};
+
+use crate::dom::bindings::codegen::Bindings::LockManagerBinding::{LockMethods, LockMode};
