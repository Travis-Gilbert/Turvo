{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Turvo Hello World",
  "version": "0.1.0",
  "identifier": "dev.turvo.helloworld",
  "build": {
    "frontendDist": [
      "index.html"
    ]
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Turvo Hello World",
        "width": 800,
        "height": 600,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "../../assets/icons/512x512.png"
    ]
  }
}
