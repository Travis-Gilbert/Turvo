{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Turvo API",
  "version": "0.1.0",
  "identifier": "dev.turvo.api",
  "build": {
    "frontendDist": "."
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'"
    },
    "windows": [
      {
        "label": "main",
        "title": "Turvo API",
        "width": 800,
        "height": 640
      }
    ]
  },
  "bundle": {
    "active": false
  }
}
