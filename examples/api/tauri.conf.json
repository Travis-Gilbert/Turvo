{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Turvo API",
  "version": "0.1.0",
  "identifier": "dev.turvo.api",
  "build": {
    "frontendDist": "."
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; connect-src 'self' ipc: turvo-ipc:"
    },
    "windows": [
      {
        "label": "main",
        "title": "Turvo API",
        "width": 800,
        "height": 640
      }
    ]
  },
  "bundle": {
    "active": false,
    "icon": [
      "../../assets/icons/icon.png",
      "../../assets/icons/32x32.png",
      "../../assets/icons/128x128.png",
      "../../assets/icons/128x128@2x.png",
      "../../assets/icons/icon.icns",
      "../../assets/icons/icon.ico"
    ]
  }
}
